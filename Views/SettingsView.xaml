<UserControl x:Class="ServeX.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource PrimaryHeadingTextStyle}"
                           Text="Settings" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource SectionSubtitleTextStyle}"
                           Text="Keep the restaurant profile current and protect the live database with a clean backup workflow." />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatusBannerBorderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,24,0">
                    <Border Padding="24"
                            Style="{StaticResource SurfaceCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="52"
                                        Height="52"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="&#xE77B;" />
                                </Border>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Style="{StaticResource CardSectionTitleTextStyle}"
                                               Text="Restaurant Profile" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource SectionSubtitleTextStyle}"
                                               Text="These values feed the shell header, tax calculations, and day-to-day billing." />
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Margin="0,0,0,8"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="Restaurant Name" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding RestaurantName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="Phone" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0">
                                    <TextBlock Margin="0,0,0,8"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="Tax Percentage" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding TaxPercentageInput, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="License Key" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             IsReadOnly="True"
                                             Background="{StaticResource SurfaceAltBrush}"
                                             BorderBrush="{StaticResource BorderBrushWarm}"
                                             Text="{Binding LicenseKey}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Save business details here without affecting your existing backup file." />

                                <Button Grid.Column="1"
                                        Command="{Binding SaveSettingsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Text="&#xE74E;" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Text="Save Changes" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Margin="0,24,0,0"
                            Padding="24"
                            Style="{StaticResource SurfaceCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="52"
                                        Height="52"
                                        Background="{StaticResource InfoSoftBrush}"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="{StaticResource InfoBrush}"
                                               Text="&#xE7F1;" />
                                </Border>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Style="{StaticResource CardSectionTitleTextStyle}"
                                               Text="Database Backup" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource SectionSubtitleTextStyle}"
                                               Text="Create a point-in-time copy of the ServeX SQLite database before live service or major updates." />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,24,0,0"
                                    Padding="16"
                                    Style="{StaticResource SoftPanelStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               Text="Current database file" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding DatabaseFileName}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding DatabasePath}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Button Grid.Row="2"
                                    Margin="0,24,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding BackupDatabaseCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="&#xE74E;" />
                                    <TextBlock Margin="8,0,0,0"
                                               Text="Backup Database" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Padding="24"
                            Style="{StaticResource SoftPanelStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardSectionTitleTextStyle}"
                                       Text="Included Here" />
                            <TextBlock Margin="0,16,0,0"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="Restaurant name updates the shell header and billing context." />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="Phone and tax changes are saved directly to the live settings record." />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="License key stays visible for reference but cannot be edited here." />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,24,0,0"
                            Padding="24"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="{StaticResource RadiusLarge}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardSectionTitleTextStyle}"
                                       Foreground="{StaticResource WarningBrush}"
                                       Text="Backup Tip" />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="Keep a dated backup before menu imports, billing changes, or busy weekend service." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
