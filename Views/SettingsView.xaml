<UserControl x:Class="ServeX.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#0F172A" />
            <TextBlock Margin="0,8,0,0"
                       Text="Protect your live data with a simple SQLite backup."
                       Foreground="#64748B" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Padding="14"
                CornerRadius="16"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#DCFCE7" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FEE2E2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2"
              Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Padding="26"
                    Background="White"
                    BorderBrush="#D8E3EC"
                    BorderThickness="1"
                    CornerRadius="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="52"
                                Height="52"
                                Background="#DBEAFE"
                                CornerRadius="26">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="#1D4ED8"
                                       Text="&#xE7F1;" />
                        </Border>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="Database Backup" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#64748B"
                                       Text="Create a point-in-time copy of the ServeX SQLite database." />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,24,0,0"
                            Padding="18"
                            Background="#F8FAFC"
                            CornerRadius="20">
                        <StackPanel>
                            <TextBlock Foreground="#64748B"
                                       Text="Current database file" />
                            <TextBlock Margin="0,8,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Text="{Binding DatabaseFileName}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#64748B"
                                       Text="{Binding DatabasePath}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="2"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding BackupDatabaseCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Text="&#xE74E;" />
                            <TextBlock Margin="10,0,0,0"
                                       FontWeight="SemiBold"
                                       Text="Backup Database" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="24,0,0,0">
                <Border Padding="22"
                        Background="#F8FAFC"
                        BorderBrush="#D8E3EC"
                        BorderThickness="1"
                        CornerRadius="24">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Text="How It Works" />
                        <TextBlock Margin="0,16,0,0"
                                   Foreground="#475569"
                                   Text="1. Click Backup Database." />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="#475569"
                                   Text="2. Choose where to save the backup file." />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="#475569"
                                   Text="3. ServeX creates a safe SQLite copy without touching your live file." />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="22"
                        Background="#FFF7ED"
                        CornerRadius="24">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#9A3412"
                                   Text="Tip" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="#9A3412"
                                   Text="Keep a dated backup before major menu edits, billing changes, or live service." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
