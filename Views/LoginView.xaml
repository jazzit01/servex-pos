<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:ServeX.Helpers" x:Class="ServeX.Views.LoginView">
    <StackPanel MaxWidth="440" HorizontalAlignment="Stretch">
        <HeaderedContentControl Header="Welcome back" Content="{Binding RestaurantName}" ContentStringFormat="Sign in to {0} to continue service." Style="{StaticResource PageHeaderStyle}"/>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperationFeedbackTemplate}"/>
        <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}"/>
        <TextBox Style="{StaticResource FormTextBoxStyle}" AutomationProperties.Name="Username" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
        <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
        <PasswordBox Style="{StaticResource FormPasswordBoxStyle}" AutomationProperties.Name="Password" helpers:PasswordBoxAssistant.BindPassword="True" helpers:PasswordBoxAssistant.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
        <CheckBox Content="Remember my username on this PC" IsChecked="{Binding RememberUsername}" Margin="0,12,0,20"/>
        <Button Content="Sign in" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryActionButtonStyle}" IsDefault="True" MinHeight="48"/>
    </StackPanel>
</UserControl>
