<UserControl x:Class="ServeX.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ServeX.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid MaxWidth="480"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                       Text="Sign in to continue" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource SectionSubtitleTextStyle}"
                       Text="{Binding RestaurantName, StringFormat=Enter the admin credentials for {0} and continue into the live workspace.}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource StatusBannerBorderStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Padding="20"
                Style="{StaticResource SoftPanelStyle}"
                HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,8"
                           Text="Username" />
                <TextBox Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Password" />
                <PasswordBox Style="{StaticResource FormPasswordBoxStyle}"
                             helpers:PasswordBoxAssistant.BindPassword="True"
                             helpers:PasswordBoxAssistant.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Use the admin account created during setup." />

                    <Button Grid.Column="1"
                            IsDefault="True"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Text="&#xE72E;" />
                            <TextBlock Margin="10,0,0,0"
                                       Text="Login" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
