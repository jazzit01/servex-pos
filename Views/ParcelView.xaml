<UserControl x:Class="ServeX.Views.ParcelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid Margin="16,16,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource PrimaryHeadingTextStyle}"
                           Text="Parcel Orders" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource SectionSubtitleTextStyle}"
                           Text="Create takeaway orders quickly with the same menu flow and a cleaner checkout summary." />
            </StackPanel>

            <ListBox Grid.Row="1"
                     Margin="0,16,0,0"
                     HorizontalAlignment="Stretch"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     Style="{StaticResource ChipListBoxStyle}"
                     ItemContainerStyle="{StaticResource ChipListBoxItemStyle}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <ScrollViewer Grid.Row="2"
                          Margin="0,16,0,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding FilteredMenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,16"
                                    Padding="16"
                                    Style="{StaticResource SurfaceCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Style="{StaticResource CardSectionTitleTextStyle}"
                                                   Text="{Binding Name}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource SectionSubtitleTextStyle}"
                                                   Text="{Binding Category}" />
                                        <StackPanel Margin="0,16,0,0"
                                                    Orientation="Horizontal">
                                            <Border Padding="12,8"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    CornerRadius="{StaticResource RadiusMedium}"
                                                    ClipToBounds="True">
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Text="{Binding Price, StringFormat=Rs. {0:N2}}" />
                                            </Border>
                                            <Border Margin="8,0,0,0"
                                                    Padding="12,8"
                                                    CornerRadius="{StaticResource RadiusMedium}"
                                                    ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                            <Setter Property="Text" Value="Unavailable" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                    <Setter Property="Text" Value="Available" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsAvailable}"
                                            Style="{StaticResource PrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE710;" />
                                            <TextBlock Text="Add Item" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2"
                Margin="0,16,16,16"
                Padding="18"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Style="{StaticResource CardSectionTitleTextStyle}"
                               Text="Parcel Summary" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource SectionSubtitleTextStyle}"
                               Text="No table required" />
                    <StackPanel Margin="0,16,0,0"
                                Orientation="Horizontal">
                        <Button Focusable="False"
                                IsHitTestVisible="False"
                                Style="{StaticResource SegmentedTabButtonStyle}">
                            <TextBlock Text="Table" />
                        </Button>
                        <Button Margin="8,0,0,0"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Style="{StaticResource SegmentedTabButtonStyle}">
                            <TextBlock Text="Room" />
                        </Button>
                        <Button Margin="8,0,0,0"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Style="{StaticResource SelectedSegmentedTabButtonStyle}">
                            <TextBlock Text="Parcel" />
                        </Button>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Customer Name" />
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource SectionSubtitleTextStyle}"
                               Text="{Binding CustomerNameDisplay, StringFormat=Will bill as: {0}}" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusBannerBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Text="{Binding StatusMessage}" />
                </Border>

                <Grid Grid.Row="2"
                      Margin="0,16,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding OrderItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,16"
                                            Padding="16"
                                            Style="{StaticResource SoftPanelStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Margin="0,8,0,0"
                                                           Style="{StaticResource SectionSubtitleTextStyle}"
                                                           Text="{Binding Category}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Text="{Binding LineTotal, StringFormat=Rs. {0:N2}}" />

                                            <StackPanel Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,16,0,0"
                                                        Orientation="Horizontal">
                                                <Button Width="44"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryActionButtonStyle}">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                               Text="&#xE738;" />
                                                </Button>
                                                <Border Padding="14,12"
                                                        Style="{StaticResource SurfaceCardStyle}">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Text="{Binding Quantity}" />
                                                </Border>
                                                <Button Width="44"
                                                        Margin="8,0,0,0"
                                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryActionButtonStyle}">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                               Text="&#xE710;" />
                                                </Button>
                                                <Button Margin="16,0,0,0"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerActionButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Margin="0,0,8,0"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   Text="&#xE74D;" />
                                                        <TextBlock Text="Remove" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Padding="24"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource SoftPanelStyle}"
                            Visibility="{Binding IsEmptyOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionSubtitleTextStyle}"
                                   Text="Add menu items to start the parcel order." />
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Margin="0,16,0,0"
                        Padding="16"
                        Style="{StaticResource SoftPanelStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionSubtitleTextStyle}"
                                       Text="Subtotal" />
                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{Binding Subtotal, StringFormat=Rs. {0:N2}}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionSubtitleTextStyle}"
                                       Text="{Binding TaxLabel}" />
                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{Binding Tax, StringFormat=Rs. {0:N2}}" />
                        </Grid>
                        <Border Margin="0,16,0,16"
                                Height="1"
                                Background="{StaticResource BorderBrushWarm}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="Total" />
                            <TextBlock Grid.Column="1"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding Total, StringFormat=Rs. {0:N2}}" />
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Command="{Binding NewParcelCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE72C;" />
                                    <TextBlock Text="New Parcel" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding SaveOrderCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE74E;" />
                                    <TextBlock Text="Save Order" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4"
                                    Command="{Binding GenerateBillCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8C7;" />
                                    <TextBlock Text="Generate Bill" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
