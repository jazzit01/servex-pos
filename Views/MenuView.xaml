<UserControl x:Class="ServeX.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Style>

        <Style x:Key="DangerActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Foreground" Value="#991B1B" />
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="BorderBrush" Value="#FEE2E2" />
        </Style>

        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="12">
                            <AdornedElementPlaceholder />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="52" Height="30">
                                <Border x:Name="Track"
                                        Background="#CBD5E1"
                                        CornerRadius="15" />
                                <Ellipse x:Name="Thumb"
                                         Width="22"
                                         Height="22"
                                         Margin="4,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="White" />
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.6" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Right"
                    Width="360"
                    Margin="0,24,24,24"
                    Padding="24"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="24"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Create or update dishes with availability and pricing."
                                   TextWrapping="Wrap"
                                   Foreground="#64748B" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,24,0,0">
                        <TextBlock Text="Name"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBox Style="{StaticResource EditorTextBoxStyle}"
                                 Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Margin="0,18,0,0"
                                   Text="Category"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBox Style="{StaticResource EditorTextBoxStyle}"
                                 Text="{Binding EditorCategory, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Margin="0,18,0,0"
                                   Text="Price"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBox Style="{StaticResource EditorTextBoxStyle}"
                                 Text="{Binding EditorPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Margin="0,18,0,0"
                                   Text="Availability"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding EditorIsAvailable}"
                                  Content="Available for ordering" />
                    </StackPanel>

                    <Grid Grid.Row="2"
                          Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Margin="0,0,8,0"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE711;" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE74E;" />
                                <TextBlock Text="Save Item" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Menu Management"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Manage the dishes your team can order, edit, and activate in real time."
                                   TextWrapping="Wrap"
                                   Foreground="#64748B" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{Binding BeginAddCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE710;" />
                            <TextBlock Text="+ Add Item" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,20,0,0"
                        Padding="14"
                        CornerRadius="16"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#DCFCE7" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Background" Value="#FEE2E2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontWeight="SemiBold"
                               Foreground="#0F172A" />
                </Border>

                <Grid Grid.Row="2"
                      Margin="0,20,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MenuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,14"
                                            Padding="18"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.1*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="Saved to SQLite"
                                                           Foreground="#94A3B8" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Category"
                                                           FontSize="12"
                                                           Foreground="#94A3B8" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="{Binding Category}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Price"
                                                           FontSize="12"
                                                           Foreground="#94A3B8" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="{Binding Price, StringFormat=Rs. {0:N2}}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155" />
                                            </StackPanel>

                                            <Border Grid.Column="3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Padding="12,8"
                                                    CornerRadius="999">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Background" Value="#DBEAFE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569" />
                                                            <Setter Property="Text" Value="Unavailable" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                                    <Setter Property="Text" Value="Available" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Button Margin="0,0,10,0"
                                                        Padding="12,8"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryActionButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Margin="0,0,6,0"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   Text="&#xE70F;" />
                                                        <TextBlock Text="Edit" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Padding="12,8"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerActionButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Margin="0,0,6,0"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   Text="&#xE74D;" />
                                                        <TextBlock Text="Delete" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Padding="26"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="24"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="26"
                                       Text="&#xE8D2;"
                                       Foreground="#94A3B8" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="No menu items yet"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="Start by adding the first item to your menu."
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
