<UserControl x:Class="ServeX.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="52" Height="30">
                                <Border x:Name="Track"
                                        Background="#CBD5E1"
                                        CornerRadius="15" />
                                <Ellipse x:Name="Thumb"
                                         Width="22"
                                         Height="22"
                                         Margin="4,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="White" />
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.6" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Right"
                    Width="300"
                    Margin="0,16,16,16"
                    Padding="18"
                    Style="{StaticResource SurfaceCardStyle}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}"
                                   Style="{StaticResource CardSectionTitleTextStyle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Create or update dishes with availability and pricing."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SectionSubtitleTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,8"
                                   Text="Name" />
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Category" />
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding EditorCategory, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Price" />
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding EditorPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Availability" />
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding EditorIsAvailable}"
                                  Content="Available for ordering" />
                    </StackPanel>

                    <Grid Grid.Row="2"
                          Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Margin="0,0,8,0"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE711;" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE74E;" />
                                <TextBlock Text="Save Item" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="16"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource PrimaryHeadingTextStyle}"
                                   Text="Menu Management" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Manage the dishes your team can order, edit, and activate in real time."
                                   Style="{StaticResource SectionSubtitleTextStyle}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{Binding BeginAddCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE710;" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="+ Add Item" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusBannerBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                </Border>

                <Grid Grid.Row="2"
                      Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="14,10"
                                Style="{StaticResource SurfaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#64748B"
                                           Text="&#xE721;" />
                                <TextBox Grid.Column="1"
                                         BorderThickness="0"
                                        Background="Transparent"
                                         Foreground="{StaticResource TextBrush}"
                                         FontSize="14"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="12,10"
                                Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE711;" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,0"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding FilteredMenuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,14"
                                            Padding="16"
                                            Style="{StaticResource SoftPanelStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.1*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource CardSectionTitleTextStyle}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="Saved to SQLite"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Category"
                                                           FontSize="12"
                                                           Foreground="#94A3B8" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="{Binding Category}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Price"
                                                           FontSize="12"
                                                           Foreground="#94A3B8" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="{Binding Price, StringFormat=Rs. {0:N2}}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155" />
                                            </StackPanel>

                                            <Border Grid.Column="3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Padding="12,8"
                                                    CornerRadius="999">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Background" Value="#DBEAFE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569" />
                                                            <Setter Property="Text" Value="Unavailable" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                                    <Setter Property="Text" Value="Available" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Button Margin="0,0,10,0"
                                                        Padding="12,8"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryActionButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Margin="0,0,6,0"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   Text="&#xE70F;" />
                                                        <TextBlock Text="Edit" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Padding="12,8"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerActionButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Margin="0,0,6,0"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   Text="&#xE74D;" />
                                                        <TextBlock Text="Delete" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Padding="24"
                            Style="{StaticResource SoftPanelStyle}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Left"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="26"
                                       Text="&#xE8D2;"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding EmptyStateTitle}"
                                       Style="{StaticResource CardSectionTitleTextStyle}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding EmptyStateSubtitle}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
