<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewModels="clr-namespace:ServeX.ViewModels" xmlns:views="clr-namespace:ServeX.Views" xmlns:models="clr-namespace:ServeX.Models" xmlns:navigation="clr-namespace:ServeX.Presentation.Navigation" x:Class="ServeX.Views.MainWindow" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}" Title="{Binding Title}" Language="{Binding MoneyLanguage}" Width="1280" Height="760" MinWidth="1100" MinHeight="680" Icon="/ServeX;component/Assets/ServeX.ico" WindowStartupLocation="CenterScreen" Style="{StaticResource ShellWindowStyle}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DayCloseViewModel}">
            <views:DayCloseView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MenuViewModel}">
            <views:MenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TablesViewModel}">
            <views:TablesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ParcelViewModel}">
            <views:ParcelView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:OrderViewModel}">
            <views:OrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BillingViewModel}">
            <views:BillingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RoomsViewModel}">
            <views:RoomsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:OpenOrdersViewModel}">
            <views:OpenOrdersView/>
        </DataTemplate>
        <Style x:Key="WorkspaceTabStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding CurrentSectionTitle}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentSectionSubtitle}" Margin="0,4,0,0" Style="{StaticResource SectionSubtitleTextStyle}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding BackButtonLabel}" Command="{Binding GoBackCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,14,0" VerticalAlignment="Center"
                        Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVisibility}}"/>
                <Border Grid.Column="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="12,8,20,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- Clock badge: a solid disc with a soft outer ring -->
                        <Grid Width="54" Height="54" Margin="0,0,14,0" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                            <Ellipse Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" Opacity="0.5"/>
                            <Ellipse Margin="6" Fill="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="22" TextWrapping="NoWrap"
                                       Foreground="{StaticResource SidebarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" MinWidth="158">
                            <TextBlock x:Name="HeaderClock" FontSize="34" FontWeight="Bold" TextWrapping="NoWrap"
                                       Typography.NumeralAlignment="Tabular" Foreground="{StaticResource SidebarTextBrush}"
                                       AutomationProperties.Name="Local time"/>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" TextWrapping="NoWrap"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0"
                                           AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock x:Name="HeaderDate" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap"
                                           Foreground="{StaticResource SidebarMutedBrush}" AutomationProperties.Name="Local month and year"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" Padding="10,10,10,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button x:Name="ToggleSidebarButton" Click="ToggleSidebar" Width="44" Height="44" Padding="0"
                            DockPanel.Dock="Left" VerticalAlignment="Center" ToolTip="Collapse sidebar" AutomationProperties.Name="Collapse sidebar"
                            Style="{StaticResource SecondaryActionButtonStyle}" Background="Transparent">
                        <Path Data="M 0,0 L 20,0 M 0,6 L 20,6 M 0,12 L 20,12"
                              Stroke="{StaticResource SidebarTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <StackPanel x:Name="SidebarBrand" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ServeX" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SidebarTextBrush}"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" KeyboardNavigation.TabNavigation="Continue">
                    <Button Content="Floor" Tag="&#xE14C;" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:WorkspaceDestination.Tables}" AutomationProperties.Name="Floor">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFloorSection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="AutomationProperties.ItemStatus" Value="Current section"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Orders" Tag="&#xE7BF;" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:WorkspaceDestination.Orders}" AutomationProperties.Name="Orders">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrdersSection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="AutomationProperties.ItemStatus" Value="Current section"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Sales" Tag="&#xE9D2;" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:WorkspaceDestination.History}" AutomationProperties.Name="Sales">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSalesSection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="AutomationProperties.ItemStatus" Value="Current section"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Manage" Tag="&#xE713;" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static navigation:WorkspaceDestination.Menu}" AutomationProperties.Name="Manage" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManageSection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="AutomationProperties.ItemStatus" Value="Current section"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="{StaticResource SidebarHoverBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <StackPanel x:Name="SidebarAccount">
                        <TextBlock Text="{Binding RestaurantName}" Foreground="{StaticResource SidebarTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Signed in as" Margin="0,12,0,2" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}"/>
                        <TextBlock Text="{Binding CurrentUsername}" Foreground="{StaticResource SidebarTextBrush}"/>
                        </StackPanel>
                        <Button Content="Sign out" Tag="&#xE7E8;" Command="{Binding SignOutCommand}" AutomationProperties.Name="Sign out" Style="{StaticResource SidebarNavigationButtonStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentControl Grid.Row="0" Margin="20,12,20,0" Content="{Binding}" ContentTemplate="{StaticResource StatusMessageTemplate}"/>
            <Grid Grid.Row="1" Margin="20,8,20,0">
                <WrapPanel Visibility="{Binding ShowFloorTabs, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Indoor" Tag="{Binding IsIndoorTab}" Command="{Binding FloorAreaCommand}" CommandParameter="{x:Static models:TableArea.Indoor}"
                            Style="{StaticResource WorkspaceTabStyle}"/>
                    <Button Content="Outdoor" Tag="{Binding IsOutdoorTab}" Command="{Binding FloorAreaCommand}" CommandParameter="{x:Static models:TableArea.Outdoor}"
                            Style="{StaticResource WorkspaceTabStyle}"/>
                    <Button Content="Rooms" Tag="{Binding IsRoomsTab}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Rooms}"
                            Style="{StaticResource WorkspaceTabStyle}"/>
                </WrapPanel>
                <WrapPanel Visibility="{Binding ShowSalesTabs, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Transactions" Tag="{Binding IsTransactionsTab}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.History}"
                            Style="{StaticResource WorkspaceTabStyle}"/>
                    <Button Content="Overview" Tag="{Binding IsOverviewTab}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Dashboard}"
                            Style="{StaticResource WorkspaceTabStyle}"/>
                </WrapPanel>
                <WrapPanel Visibility="{Binding ShowManageTabs, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Menu" Tag="{Binding IsMenuTab}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Menu}"
                            Style="{StaticResource WorkspaceTabStyle}"/>
                    <Button Content="Table setup" Tag="{Binding IsTableSetupTab}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.TableSetup}"
                            Style="{StaticResource WorkspaceTabStyle}"/>
                    <Button Content="Settings" Tag="{Binding IsSettingsTab}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Settings}"
                            Style="{StaticResource WorkspaceTabStyle}"/>
                </WrapPanel>
            </Grid>
            <ContentControl Grid.Row="2" Content="{Binding CurrentWorkspace}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
