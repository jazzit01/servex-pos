<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewModels="clr-namespace:ServeX.ViewModels" xmlns:views="clr-namespace:ServeX.Views" xmlns:navigation="clr-namespace:ServeX.Presentation.Navigation" x:Class="ServeX.Views.MainWindow" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}" Title="{Binding Title}" Width="1280" Height="760" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen" Style="{StaticResource ShellWindowStyle}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MenuViewModel}">
            <views:MenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TablesViewModel}">
            <views:TablesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ParcelViewModel}">
            <views:ParcelView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:OrderViewModel}">
            <views:OrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BillingViewModel}">
            <views:BillingView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}" Padding="16,24,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="10,0,0,28">
                    <TextBlock Text="ServeX" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SidebarTextBrush}"/>
                    <TextBlock Text="POINT OF SALE" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource SidebarMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" KeyboardNavigation.TabNavigation="Continue">
                    <Button Content="Dashboard" Tag="" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Dashboard}" AutomationProperties.Name="Dashboard">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Dashboard}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Menu" Tag="" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Menu}" AutomationProperties.Name="Menu">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Menu}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Tables" Tag="" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Tables}" AutomationProperties.Name="Tables">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Tables}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Parcel" Tag="" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Parcel}" AutomationProperties.Name="Parcel">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Parcel}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Settings" Tag="" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Settings}" AutomationProperties.Name="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Settings}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="{StaticResource SidebarHoverBrush}" BorderThickness="0,1,0,0" Padding="10,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding RestaurantName}" Foreground="{StaticResource SidebarTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Signed in as" Margin="0,12,0,2" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}"/>
                        <TextBlock Text="{Binding CurrentUsername}" Foreground="{StaticResource SidebarTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentSectionTitle}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentSectionSubtitle}" Margin="0,4,16,0" Style="{StaticResource SectionSubtitleTextStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding BackButtonLabel}" Command="{Binding GoBackCommand}" Style="{StaticResource SecondaryActionButtonStyle}" VerticalAlignment="Center" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Margin="20,12,20,0" Content="{Binding}" ContentTemplate="{StaticResource StatusMessageTemplate}"/>
            <ContentControl Grid.Row="2" Content="{Binding CurrentWorkspace}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
