<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewModels="clr-namespace:ServeX.ViewModels" xmlns:views="clr-namespace:ServeX.Views" xmlns:navigation="clr-namespace:ServeX.Presentation.Navigation" x:Class="ServeX.Views.MainWindow" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}" Title="{Binding Title}" Language="{Binding MoneyLanguage}" Width="1280" Height="760" MinWidth="1100" MinHeight="680" Icon="/ServeX;component/Assets/ServeX.ico" WindowStartupLocation="CenterScreen" Style="{StaticResource ShellWindowStyle}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MenuViewModel}">
            <views:MenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TablesViewModel}">
            <views:TablesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ParcelViewModel}">
            <views:ParcelView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:OrderViewModel}">
            <views:OrderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BillingViewModel}">
            <views:BillingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RoomsViewModel}">
            <views:RoomsView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,10,18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ToggleSidebarButton" Click="ToggleSidebar" Width="44" Height="44" Padding="0" Margin="0,0,14,0"
                        VerticalAlignment="Center" ToolTip="Collapse sidebar" AutomationProperties.Name="Collapse sidebar"
                        Style="{StaticResource SecondaryActionButtonStyle}">
                    <Path Data="M 0,0 L 20,0 M 0,6 L 20,6 M 0,12 L 20,12"
                          Stroke="{StaticResource SidebarTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding CurrentSectionTitle}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentSectionSubtitle}" Margin="0,4,0,0" Style="{StaticResource SectionSubtitleTextStyle}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding BackButtonLabel}" Command="{Binding GoBackCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,14,0" VerticalAlignment="Center"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"/>
                <Border Grid.Column="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource SidebarHoverBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right" MinWidth="118">
                        <TextBlock x:Name="HeaderDate" TextAlignment="Right" FontSize="12"
                                   Foreground="{StaticResource SidebarMutedBrush}" AutomationProperties.Name="Local date"/>
                        <TextBlock x:Name="HeaderClock" TextAlignment="Right" FontSize="23" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" Foreground="{StaticResource SidebarTextBrush}"
                                   AutomationProperties.Name="Local time"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource SidebarBrush}" Padding="10,16,10,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12">
                    <StackPanel x:Name="SidebarBrand" Margin="8,8,0,0">
                    <TextBlock Text="ServeX" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SidebarTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" KeyboardNavigation.TabNavigation="Continue">
                    <Button Content="Dashboard" Tag="" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Dashboard}" AutomationProperties.Name="Dashboard">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Dashboard}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Menu" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" Tag="&#xE8FD;" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Menu}" AutomationProperties.Name="Menu">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Menu}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Tables" Tag="&#xE8A9;" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Tables}" AutomationProperties.Name="Tables">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Tables}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Parcel" Tag="" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Parcel}" AutomationProperties.Name="Parcel">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Parcel}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Rooms" Tag="&#xE8B7;" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Rooms}" AutomationProperties.Name="Rooms">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Rooms}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="History and sales" Tag="&#xE81C;" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.History}" AutomationProperties.Name="History and sales">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.History}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Settings" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" Tag="" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:WorkspaceDestination.Settings}" AutomationProperties.Name="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Settings}">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="{StaticResource SidebarHoverBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <StackPanel x:Name="SidebarAccount">
                        <TextBlock Text="{Binding RestaurantName}" Foreground="{StaticResource SidebarTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Signed in as" Margin="0,12,0,2" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}"/>
                        <TextBlock Text="{Binding CurrentUsername}" Foreground="{StaticResource SidebarTextBrush}"/>
                        </StackPanel>
                        <Button Content="Sign out" Tag="&#xE7E8;" Command="{Binding SignOutCommand}" AutomationProperties.Name="Sign out" Style="{StaticResource SidebarNavigationButtonStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentControl Grid.Row="0" Margin="20,12,20,0" Content="{Binding}" ContentTemplate="{StaticResource StatusMessageTemplate}"/>
            <ContentControl Grid.Row="1" Content="{Binding CurrentWorkspace}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
