<Window x:Class="ServeX.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ServeX.ViewModels"
        xmlns:views="clr-namespace:ServeX.Views"
        xmlns:navigation="clr-namespace:ServeX.Presentation.Navigation"
        Title="{Binding Title}"
        Width="1280"
        Height="760"
        MinWidth="1100"
        MinHeight="680"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Style="{StaticResource ShellWindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MenuViewModel}">
            <views:MenuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TablesViewModel}">
            <views:TablesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ParcelViewModel}">
            <views:ParcelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Border Style="{StaticResource SurfaceCardStyle}"
                Background="{StaticResource ShellBrush}"
                CornerRadius="{StaticResource RadiusXLarge}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Margin="16"
                        Padding="16"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="{StaticResource RadiusLarge}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Width="48"
                                        Height="48"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="20"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="&#xE8D2;" />
                                </Border>

                                <TextBlock Margin="0,12,0,0"
                                           FontFamily="{StaticResource BrandFontFamily}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="ServeX" />

                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Restaurant service, orders, billing, and floor control in one connected desktop workspace."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Margin="0,16,0,0">
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static navigation:WorkspaceDestination.Dashboard}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Dashboard}">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            Background="{StaticResource AccentSoftBrush}"
                                            CornerRadius="{StaticResource RadiusSmall}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Text="&#xE80F;" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="Dashboard" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Service overview" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Margin="0,12,0,0"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static navigation:WorkspaceDestination.Menu}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Menu}">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            Background="{StaticResource PrimarySoftBrush}"
                                            CornerRadius="{StaticResource RadiusSmall}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Text="&#xE8D2;" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="Menu" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Items and pricing" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Margin="0,12,0,0"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static navigation:WorkspaceDestination.Tables}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Tables}">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            Background="{StaticResource SuccessSoftBrush}"
                                            CornerRadius="{StaticResource RadiusSmall}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   Text="&#xE14C;" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="Tables" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Indoor and outdoor floor" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Margin="0,12,0,0"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static navigation:WorkspaceDestination.Parcel}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Parcel}">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            Background="{StaticResource InfoSoftBrush}"
                                            CornerRadius="{StaticResource RadiusSmall}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource InfoBrush}"
                                                   Text="&#xE7BF;" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="Parcel" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Takeaway desk" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Margin="0,12,0,0"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static navigation:WorkspaceDestination.Settings}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDestination}" Value="{x:Static navigation:WorkspaceDestination.Settings}">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            Background="{StaticResource WarningSoftBrush}"
                                            CornerRadius="{StaticResource RadiusSmall}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Text="&#xE713;" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="Settings" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Backups and tools" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Padding="16"
                                    Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               Text="Signed in as" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding CurrentUsername}" />
                                    <TextBlock Margin="0,12,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding Summary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1"
                      Margin="0,16,0,16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Margin="0,0,16,16"
                            Padding="16"
                            Style="{StaticResource SurfaceCardStyle}"
                            HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="48"
                                    Height="48"
                                    Background="{StaticResource PrimarySoftBrush}"
                                    CornerRadius="{StaticResource RadiusSmall}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="{Binding CurrentSectionIconGlyph}" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource PrimaryHeadingTextStyle}"
                                           FontSize="24"
                                           Text="{Binding CurrentSectionTitle}" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SectionSubtitleTextStyle}"
                                           Text="{Binding CurrentSectionSubtitle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Command="{Binding GoBackCommand}"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE72B;" />
                                        <TextBlock Text="Back to Dashboard" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding RestaurantName}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,0,16,16"
                            Padding="12"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusBannerBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,0,16,0"
                            Padding="0"
                            Style="{StaticResource SurfaceCardStyle}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <ContentControl Content="{Binding CurrentWorkspace}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </Border>
                </Grid>

                <ScrollViewer Grid.Column="2"
                              Margin="0,16,16,16"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="18"
                                Background="{StaticResource TextBrush}"
                                CornerRadius="{StaticResource RadiusLarge}">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource BrandFontFamily}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Text="{Binding RestaurantName}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="#E8DDD2"
                                           Text="Quiet oversight for a busy floor. The numbers here stay visible while you move through service."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1"
                                    Margin="0,16,0,0">
                            <Border Padding="18"
                                    Style="{StaticResource SoftPanelStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Menu Items" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding MenuItemsCount}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="18"
                                    Background="{StaticResource SuccessSoftBrush}"
                                    CornerRadius="{StaticResource RadiusLarge}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Text="Live Tables" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding TableCount}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="18"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="{StaticResource RadiusLarge}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}"
                                               Text="Orders" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding OrderCount}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="18"
                                    Style="{StaticResource SoftPanelStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Service note" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding CurrentSectionSubtitle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
