<UserControl x:Class="ServeX.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ServeX.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                           Text="Set up your restaurant" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource SectionSubtitleTextStyle}"
                           Text="Capture the essential business profile, tax rate, and admin access once so the team can move directly into service." />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,22,0,0"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatusBannerBorderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,12,0"
                        Padding="22"
                        Style="{StaticResource SoftPanelStyle}">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="Restaurant Profile" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SectionSubtitleTextStyle}"
                                   Text="These details appear across bills, tax calculations, and the shell header." />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Restaurant Name" />
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding RestaurantName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Address" />
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 MinHeight="96"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Phone" />
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Tax Percentage" />
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding TaxPercentageInput, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="22"
                        Style="{StaticResource SoftPanelStyle}">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="Admin Access" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SectionSubtitleTextStyle}"
                                   Text="Create the first admin sign-in that will take ownership of this installation." />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Admin Username" />
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Admin Password" />
                        <PasswordBox Style="{StaticResource FormPasswordBoxStyle}"
                                     helpers:PasswordBoxAssistant.BindPassword="True"
                                     helpers:PasswordBoxAssistant.BoundPassword="{Binding AdminPassword, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="License Key" />
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                        <Border Margin="0,18,0,0"
                                Padding="16"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="{StaticResource RadiusMedium}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{StaticResource WarningBrush}"
                                           Text="&#xE946;" />
                                <TextBlock Margin="10,0,0,0"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="For local development, the license field can stay blank." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3"
                  Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="You will be taken to login as soon as setup is saved." />

                <Button Grid.Column="1"
                        IsDefault="True"
                        Command="{Binding SaveSetupCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Text="&#xE8FB;" />
                        <TextBlock Margin="10,0,0,0"
                                   Text="Save Setup" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
