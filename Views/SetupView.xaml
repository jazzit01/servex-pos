<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:ServeX.Helpers" x:Class="ServeX.Views.SetupView">
    <StackPanel MaxWidth="680" HorizontalAlignment="Stretch">
        <HeaderedContentControl Header="Set up your restaurant" Content="Create your restaurant profile and administrator account." Style="{StaticResource PageHeaderStyle}"/>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperationFeedbackTemplate}"/>
        <TextBlock Text="Restaurant details" Style="{StaticResource SectionTitleTextStyle}" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Restaurant name" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Style="{StaticResource FormTextBoxStyle}" AutomationProperties.Name="Restaurant name" Text="{Binding RestaurantName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Style="{StaticResource FormTextBoxStyle}" AutomationProperties.Name="Phone" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}"/>
        <TextBox Style="{StaticResource FormTextBoxStyle}" AutomationProperties.Name="Address" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tax percentage" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Style="{StaticResource FormTextBoxStyle}" AutomationProperties.Name="Tax percentage" Text="{Binding TaxPercentageInput, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="License key" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Style="{StaticResource FormTextBoxStyle}" AutomationProperties.Name="License key" Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="Administrator account" Style="{StaticResource SectionTitleTextStyle}" Margin="0,24,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Admin username" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Style="{StaticResource FormTextBoxStyle}" AutomationProperties.Name="Admin username" Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Admin password" Style="{StaticResource FieldLabelStyle}"/>
                <PasswordBox Style="{StaticResource FormPasswordBoxStyle}" AutomationProperties.Name="Admin password" helpers:PasswordBoxAssistant.BindPassword="True" helpers:PasswordBoxAssistant.BoundPassword="{Binding AdminPassword, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="Keep your administrator credentials secure. You will sign in after setup is saved." Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,20"/>
        <Button Content="Save setup and continue" Command="{Binding SaveSetupCommand}" Style="{StaticResource PrimaryActionButtonStyle}" IsDefault="True" MinHeight="48"/>
    </StackPanel>
</UserControl>
