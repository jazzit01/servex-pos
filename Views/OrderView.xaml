<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:ServeX.Presentation.Components" x:Class="ServeX.Views.OrderView">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperationFeedbackTemplate}"/>
            <WrapPanel Margin="0,0,0,8" Visibility="{Binding CanTransfer, Converter={StaticResource BoolToVisibility}}">
                <ComboBox ItemsSource="{Binding TransferTargets}" DisplayMemberPath="TableNumber" SelectedItem="{Binding TransferTarget}"
                          AutomationProperties.Name="Destination table" Width="150" Margin="0,0,8,0"/>
                <Button Content="Move or merge saved order" Command="{Binding TransferCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>
            <components:MenuPicker/>
            <components:OrderSummary Grid.Column="2"/>
        </Grid>
    </Grid>
</UserControl>
