<Window x:Class="ServeX.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ServeX.ViewModels"
        xmlns:views="clr-namespace:ServeX.Views"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="760"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Style="{StaticResource ShellWindowStyle}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:SetupViewModel}">
            <views:SetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Border Style="{StaticResource SurfaceCardStyle}"
                Background="{StaticResource ShellBrush}"
                CornerRadius="{StaticResource RadiusXLarge}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Grid ClipToBounds="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#8D4F37" Offset="0" />
                            <GradientStop Color="#5C3325" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Border Width="56"
                                    Height="56"
                                    Background="#F7EBDD"
                                    CornerRadius="{StaticResource RadiusLarge}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="28"
                                           Foreground="#8D4F37"
                                           Text="&#xE8D2;" />
                            </Border>

                            <TextBlock Margin="0,16,0,0"
                                       FontFamily="{StaticResource BrandFontFamily}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="ServeX" />

                            <TextBlock Margin="0,10,0,0"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#F6EDE4"
                                       Text="{Binding PanelTitle}" />

                            <TextBlock Margin="0,10,0,0"
                                       FontSize="14"
                                       Foreground="#E9D9CB"
                                       Text="{Binding PanelSubtitle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center">
                            <Border Margin="0,0,0,12"
                                    Padding="14"
                                    Background="#20FFF8EF"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="#FFE6C1"
                                               Text="&#xE8FD;" />
                                    <TextBlock Margin="12,0,0,0"
                                               Foreground="#FFF3E6"
                                               Text="Built for a fast dining room, not a generic office dashboard." />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,0,12"
                                    Padding="14"
                                    Background="#20FFF8EF"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="#D5F3E0"
                                               Text="&#xE930;" />
                                    <TextBlock Margin="12,0,0,0"
                                               Foreground="#FFF3E6"
                                               Text="Restaurant identity, tax settings, and admin access stay in one place." />
                                </StackPanel>
                            </Border>

                            <Border Padding="14"
                                    Background="#20FFF8EF"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="#F9D7C8"
                                               Text="&#xE7BF;" />
                                <TextBlock Margin="10,0,0,0"
                                               Foreground="#FFF3E6"
                                               Text="Setup flows cleanly into login so staff can get into service quickly." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="2"
                                Padding="14"
                                Background="#20FFF8EF"
                                CornerRadius="{StaticResource RadiusMedium}">
                            <TextBlock Foreground="#F6EDE4"
                                       Text="Local development mode is active, so the license field is optional."
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1"
                      Margin="16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Border Style="{StaticResource SurfaceCardStyle}"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Grid HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                            <ContentControl Content="{Binding CurrentViewModel}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
