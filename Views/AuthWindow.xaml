<Window x:Class="ServeX.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ServeX.ViewModels"
        xmlns:views="clr-namespace:ServeX.Views"
        Title="{Binding WindowTitle}"
        Width="1120"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        Background="#EAF0F5"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:SetupViewModel}">
            <views:SetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="1.15*" />
        </Grid.ColumnDefinitions>

        <Border Padding="40"
                Background="#0F172A"
                CornerRadius="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="60"
                            Height="60"
                            Background="#DBEAFE"
                            CornerRadius="30">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="26"
                                   Foreground="#1D4ED8"
                                   Text="&#xE8D2;" />
                    </Border>
                    <TextBlock Margin="0,22,0,0"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="ServeX" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#E2E8F0"
                               Text="{Binding PanelTitle}" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding PanelSubtitle}"
                               FontSize="16"
                               Foreground="#CBD5E1"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center">
                    <Border Margin="0,0,0,16"
                            Padding="18"
                            Background="#162033"
                            CornerRadius="22">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#60A5FA"
                                       Text="&#xE73E;" />
                            <TextBlock Margin="12,0,0,0"
                                       Foreground="#E2E8F0"
                                       Text="Secure first-run setup and admin sign-in flow." />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,16"
                            Padding="18"
                            Background="#162033"
                            CornerRadius="22">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#34D399"
                                       Text="&#xE930;" />
                            <TextBlock Margin="12,0,0,0"
                                       Foreground="#E2E8F0"
                                       Text="Local development mode keeps setup and login simple." />
                        </StackPanel>
                    </Border>
                    <Border Padding="18"
                            Background="#162033"
                            CornerRadius="22">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#F59E0B"
                                       Text="&#xE74C;" />
                            <TextBlock Margin="12,0,0,0"
                                       Foreground="#E2E8F0"
                                       Text="Smooth handoff into the main dashboard after login." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Foreground="#94A3B8"
                           Text="License is optional in local development." />
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="24,0,0,0"
                Padding="30"
                Background="White"
                CornerRadius="30"
                BorderBrush="#D8E3EC"
                BorderThickness="1">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>
