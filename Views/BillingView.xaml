<UserControl x:Class="ServeX.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid Margin="24,24,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource PrimaryHeadingTextStyle}"
                           Text="Billing" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource SectionSubtitleTextStyle}"
                           Text="{Binding TableNumber, StringFormat=Review the receipt and settle the bill for table {0}.}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,24,0,0"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatusBannerBorderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Text="{Binding StatusMessage}" />
            </Border>

            <Border Grid.Row="2"
                    Margin="0,24,0,0"
                    Padding="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource CardSectionTitleTextStyle}"
                               Text="Items" />

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,24,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,16"
                                            Padding="16"
                                            Style="{StaticResource SoftPanelStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Margin="0,8,0,0"
                                                           Style="{StaticResource SectionSubtitleTextStyle}"
                                                           Text="{Binding Quantity, StringFormat=Qty: {0}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding UnitPrice, StringFormat=Rs. {0:N2}}" />
                                                <TextBlock Margin="0,8,0,0"
                                                           HorizontalAlignment="Right"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           Text="{Binding LineTotal, StringFormat=Line: Rs. {0:N2}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2"
                Margin="0,24,24,24"
                Padding="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource CardSectionTitleTextStyle}"
                           Text="{Binding WindowTitle}" />

                <StackPanel Grid.Row="1"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Stretch">
                    <TextBlock Margin="0"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Payment Method" />
                    <ListBox Margin="0,16,0,0"
                             ItemsSource="{Binding PaymentOptions}"
                             SelectedItem="{Binding SelectedPaymentMethod}"
                             Style="{StaticResource ChoiceListBoxStyle}"
                             ItemContainerStyle="{StaticResource ChoiceListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE8C7;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="Cash">
                                                        <Setter Property="Text" Value="&#xEAFD;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Card">
                                                        <Setter Property="Text" Value="&#xE8C7;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Upi">
                                                        <Setter Property="Text" Value="&#xE8EA;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Stretch">
                    <TextBlock Margin="0"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Discount" />
                    <TextBox Margin="0,16,0,0"
                             Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding DiscountInput, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="0,24,0,0"
                        Padding="20"
                        Style="{StaticResource SoftPanelStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionSubtitleTextStyle}"
                                       Text="Subtotal" />
                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{Binding Subtotal, StringFormat=Rs. {0:N2}}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionSubtitleTextStyle}"
                                       Text="{Binding TaxLabel}" />
                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{Binding Tax, StringFormat=Rs. {0:N2}}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionSubtitleTextStyle}"
                                       Text="Discount" />
                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{Binding Discount, StringFormat=Rs. {0:N2}}" />
                        </Grid>
                        <Border Margin="0,16,0,16"
                                Height="1"
                                Background="{StaticResource BorderBrushWarm}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="Final Total" />
                            <TextBlock Grid.Column="1"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="{Binding FinalTotal, StringFormat=Rs. {0:N2}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4"
                      Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding PrintReceiptCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE749;" />
                            <TextBlock Text="Print Receipt" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding ConfirmPaymentCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE73E;" />
                            <TextBlock Text="Confirm Payment" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
