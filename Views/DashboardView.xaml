<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ServeX.Views.DashboardView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperationFeedbackTemplate}"/>

            <!-- Header: date, freshness and manual refresh -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding TodayDisplay}" Style="{StaticResource PrimaryHeadingTextStyle}" FontSize="22"/>
                    <TextBlock Text="{Binding LastUpdatedDisplay}" Style="{StaticResource SectionSubtitleTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryActionButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Refresh dashboard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource GlyphTextStyle}" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Attention banner: unpaid orders that have been open for over an hour -->
            <Border Margin="0,0,0,16" Padding="14,10" CornerRadius="8" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    Visibility="{Binding HasStaleOrders, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource GlyphTextStyle}" Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StaleOrdersMessage}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Review orders" Command="{Binding OpenOrdersCommand}" Style="{StaticResource SecondaryActionButtonStyle}" MinHeight="36" Padding="12,4" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Key numbers -->
            <UniformGrid Columns="4">
                <HeaderedContentControl Margin="0,0,12,12" Background="{StaticResource PrimarySoftBrush}" BorderBrush="{StaticResource PrimaryBrush}" Header="Today's sales" Tag="{Binding PaidBillsDisplay}" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding TodaySalesDisplay}" Style="{StaticResource FinancialTextStyle}" FontSize="26"/></HeaderedContentControl.Content></HeaderedContentControl>
                <HeaderedContentControl Margin="0,0,12,12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Header="Orders today" Tag="{Binding TakeawayDisplay}" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding TotalOrdersToday}" Style="{StaticResource FinancialTextStyle}" FontSize="26"/></HeaderedContentControl.Content></HeaderedContentControl>
                <HeaderedContentControl Margin="0,0,12,12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Header="Average bill" Tag="Per paid bill today" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding AverageOrderDisplay}" Style="{StaticResource FinancialTextStyle}" FontSize="26"/></HeaderedContentControl.Content></HeaderedContentControl>
                <HeaderedContentControl Margin="0,0,0,12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Header="Awaiting payment" Tag="Open, preparing or served" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding ActiveOrders}" Style="{StaticResource FinancialTextStyle}" FontSize="26"/></HeaderedContentControl.Content></HeaderedContentControl>
            </UniformGrid>

            <!-- Start service -->
            <Border Padding="16" Margin="0,4,0,16" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <TextBlock Text="Start service" Style="{StaticResource SectionTitleTextStyle}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Command="{Binding NewTableOrderCommand}" Style="{StaticResource TilePrimaryButtonStyle}" AutomationProperties.Name="New table order">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource GlyphTextStyle}"/>
                                <TextBlock Text="New table order" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NewParcelCommand}" Style="{StaticResource TileSecondaryButtonStyle}" AutomationProperties.Name="New takeaway order">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BF;" Style="{StaticResource GlyphTextStyle}"/>
                                <TextBlock Text="New takeaway" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoToTablesCommand}" Style="{StaticResource TileSecondaryButtonStyle}" AutomationProperties.Name="Dining floor">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE14C;" Style="{StaticResource GlyphTextStyle}"/>
                                <TextBlock Text="Dining floor" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenOrdersCommand}" Style="{StaticResource TileSecondaryButtonStyle}" AutomationProperties.Name="Open orders">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource GlyphTextStyle}"/>
                                <TextBlock Text="Open orders" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DayCloseCommand}" Style="{StaticResource TileSecondaryButtonStyle}" AutomationProperties.Name="End-of-day report">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" Style="{StaticResource GlyphTextStyle}"/>
                                <TextBlock Text="End-of-day report" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SalesHistoryCommand}" Style="{StaticResource TileSecondaryButtonStyle}" AutomationProperties.Name="Sales history">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D2;" Style="{StaticResource GlyphTextStyle}"/>
                                <TextBlock Text="Sales history" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoToMenuCommand}" Style="{StaticResource TileSecondaryButtonStyle}" Visibility="{Binding CanManageMenu, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Manage menu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D2;" Style="{StaticResource GlyphTextStyle}"/>
                                <TextBlock Text="Manage menu" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- Left: orders -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Unpaid orders" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="Oldest first. Tap Open to add items or take payment." Style="{StaticResource SectionSubtitleTextStyle}" Margin="0,2,0,8"/>
                            <DataGrid ItemsSource="{Binding OpenOrderRows}" Style="{StaticResource OperationalGridStyle}" MaxHeight="300" IsReadOnly="True" Visibility="{Binding HasOpenOrders, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Unpaid orders">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="70"/>
                                    <DataGridTextColumn Header="Table / guest" Binding="{Binding Reference}" Width="*" MinWidth="120"/>
                                    <DataGridTextColumn Header="Service" Binding="{Binding ServiceLabel}" Width="100"/>
                                    <DataGridTemplateColumn Header="Status" Width="115">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                                    <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusBadgeTextStyle}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Open for" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AgeDisplay}" TextWrapping="NoWrap" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Total" Binding="{Binding DisplayTotal}" Width="110" ElementStyle="{StaticResource FinancialTextStyle}"/>
                                    <DataGridTemplateColumn Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Open" MinHeight="36" MinWidth="70" Padding="12,4" Style="{StaticResource GhostActionButtonStyle}"
                                                        Command="{Binding DataContext.ResumeOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="Open order"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="All caught up — no unpaid orders." Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding IsOpenOrdersEmpty, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Recent orders" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding RecentOrders}" Style="{StaticResource OperationalGridStyle}" MinHeight="100" MaxHeight="360" IsReadOnly="True" Visibility="{Binding HasRecentOrders, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Recent orders">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Order" Binding="{Binding OrderId, StringFormat=#{0}}" Width="70"/>
                                    <DataGridTextColumn Header="Table / guest" Binding="{Binding ReferenceLabel}" Width="*" MinWidth="130"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                                    <DataGridTemplateColumn Header="Status" Width="115">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                                    <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusBadgeTextStyle}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding DisplayTotal}" Width="120" ElementStyle="{StaticResource FinancialTextStyle}"/>
                                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd MMM HH:mm}}" Width="115"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No orders yet today." Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding IsRecentOrdersEmpty, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: floor, best sellers, payments -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Floor status" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="{Binding OccupancyDisplay}" Style="{StaticResource SectionSubtitleTextStyle}" Margin="0,4,0,10"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding OccupancyPercent, Mode=OneWay}" Height="10" BorderThickness="0"
                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelBrush}" AutomationProperties.Name="Table occupancy"/>
                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AvailableTables}" FontSize="22" Style="{StaticResource FinancialTextStyle}"/>
                                        <TextBlock Text="Available" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding OccupiedTables}" FontSize="22" Style="{StaticResource FinancialTextStyle}"/>
                                        <TextBlock Text="Occupied" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReservedTables}" FontSize="22" Style="{StaticResource FinancialTextStyle}"/>
                                        <TextBlock Text="Reserved" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Best sellers today" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding TopItems}" Visibility="{Binding HasTopItems, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Best sellers today">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource PrimarySoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Rank}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UnitsDisplay}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No sales yet today." Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding IsTopItemsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Payments today" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding PaymentRows}" Visibility="{Binding HasPayments, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Payments today by method">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Left" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding DisplayAmount}" HorizontalAlignment="Right" Style="{StaticResource FinancialTextStyle}" FontSize="14" TextWrapping="NoWrap"/>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding SharePercent, Mode=OneWay}" Height="6" Margin="0,6,0,4" BorderThickness="0"
                                                         Foreground="{StaticResource PrimaryHoverBrush}" Background="{StaticResource PanelBrush}"/>
                                            <TextBlock Text="{Binding CountDisplay}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No payments taken yet today." Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding IsPaymentsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
