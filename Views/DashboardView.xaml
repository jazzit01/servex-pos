<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ServeX.Views.DashboardView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperationFeedbackTemplate}"/>
            <TextBlock x:Name="DashboardClock" HorizontalAlignment="Right" Margin="0,0,12,8" FontSize="12" Foreground="{StaticResource MutedTextBrush}" AutomationProperties.Name="Local date and time"/>
            <UniformGrid Columns="4">
                <HeaderedContentControl Margin="0,0,12,12" Background="#172E46" BorderBrush="#172E46" Foreground="#F3F7FC" Header="Today's sales" Tag="Confirmed payments today" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding TodayRevenue, StringFormat=C2}" Style="{StaticResource FinancialTextStyle}" FontSize="26" Foreground="#F3F7FC"/></HeaderedContentControl.Content></HeaderedContentControl>
                <HeaderedContentControl Margin="0,0,12,12" Background="#F4F7FC" BorderBrush="#CBD9ED" Foreground="#254878" Header="Active orders" Tag="Open, preparing or served" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding ActiveOrders}" Style="{StaticResource FinancialTextStyle}" FontSize="26" Foreground="#254878"/></HeaderedContentControl.Content></HeaderedContentControl>
                <HeaderedContentControl Margin="0,0,12,12" Background="#FFF8EB" BorderBrush="#E9D7B5" Foreground="#6B4709" Header="Occupied tables" Tag="Currently occupied" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding OccupiedTables}" Style="{StaticResource FinancialTextStyle}" FontSize="26" Foreground="#6B4709"/></HeaderedContentControl.Content></HeaderedContentControl>
                <HeaderedContentControl Margin="0,0,12,12" Background="#EFF8F2" BorderBrush="#C8E0D2" Foreground="#20563D" Header="Available tables" Tag="Ready for service" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding AvailableTables}" Style="{StaticResource FinancialTextStyle}" FontSize="26" Foreground="#20563D"/></HeaderedContentControl.Content></HeaderedContentControl>
            </UniformGrid>
            <Border Padding="16" Margin="0,4,0,16" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <TextBlock Text="Quick actions" Style="{StaticResource SectionTitleTextStyle}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="New table order" Command="{Binding NewTableOrderCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,8,8"/>
                        <Button Content="Dining floor" Command="{Binding GoToTablesCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,8"/>
                        <Button Content="Manage menu" Command="{Binding GoToMenuCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding TotalOrdersToday, StringFormat=Orders today: {0}}" Margin="0,0,24,0" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding ParcelOrdersCount, StringFormat=Parcels today: {0}}" Margin="0,0,24,0" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding ReservedTables, StringFormat=Reserved tables: {0}}" Foreground="{StaticResource MutedTextBrush}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Unpaid orders" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding OpenOrders}" Style="{StaticResource OperationalGridStyle}" MaxHeight="240" IsReadOnly="True" AutomationProperties.Name="Unpaid orders">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <StackPanel>
                    <HeaderedContentControl Header="Recent orders" Content="Latest service activity, including unpaid orders. Sales above include confirmed payments only." Style="{StaticResource PageHeaderStyle}"/>
                    <DataGrid ItemsSource="{Binding RecentOrders}" Style="{StaticResource OperationalGridStyle}" MinHeight="100" MaxHeight="360" AutomationProperties.Name="Recent orders">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderId, StringFormat=#{0}}" Width="80"/>
                            <DataGridTextColumn Header="Guest / reference" Binding="{Binding ReferenceLabel}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="85"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Total, StringFormat=C2}" Width="160" ElementStyle="{StaticResource FinancialTextStyle}"/>
                            <DataGridTextColumn Header="Created (local)" Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd MMM HH:mm}}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <HeaderedContentControl Header="Ready for the first order" Content="New service activity will appear here. Start a table order or open the dining floor." Style="{StaticResource EmptyStateStyle}" Visibility="{Binding IsRecentOrdersEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
