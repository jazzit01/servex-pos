<UserControl x:Class="ServeX.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ServeX.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16"
          Background="Transparent"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PrimaryHeadingTextStyle}"
                       Text="Dashboard" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource SectionSubtitleTextStyle}"
                       Text="Track the day at a glance and keep recent service activity visible." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource StatusBannerBorderStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2"
              Margin="0,16,0,0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Padding="18"
                    Style="{StaticResource SurfaceCardStyle}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource CardSectionTitleTextStyle}"
                                       Text="Recent Orders" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource SectionSubtitleTextStyle}"
                                       Text="The last five service events stay visible here for quick context." />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="16,8"
                                Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{Binding TotalOrdersToday, StringFormat=Today: {0}}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,16,0,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding RecentOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            Padding="14"
                                            Style="{StaticResource SoftPanelStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontWeight="Bold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   Text="{Binding OrderId, StringFormat=Order #{0}}" />
                                                        <Border Margin="16,0,0,0"
                                                                Padding="8,4"
                                                                Background="{StaticResource PanelBrush}"
                                                                CornerRadius="{StaticResource RadiusSmall}">
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       Text="{Binding Type}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding ReferenceLabel}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding CreatedAt, StringFormat={}{0:dd MMM yyyy hh:mm tt}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            HorizontalAlignment="Right">
                                                    <Border Padding="8,4"
                                                            Background="{StaticResource PrimarySoftBrush}"
                                                            CornerRadius="{StaticResource RadiusSmall}">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                   Text="{Binding Status}" />
                                                    </Border>
                                                    <TextBlock Margin="0,12,0,0"
                                                               HorizontalAlignment="Right"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Text="{Binding Total, StringFormat=Rs. {0:N2}}" />
                                                </StackPanel>
                                            </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Padding="18"
                                Style="{StaticResource SoftPanelStyle}"
                                Visibility="{Binding IsRecentOrdersEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Recent orders will appear here once service begins." />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Stretch">
                <Border Padding="18"
                        Background="{StaticResource TextBrush}"
                        CornerRadius="{StaticResource RadiusLarge}">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource CardSectionTitleTextStyle}"
                                   Foreground="White"
                                   Text="Today" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#E8DDD2"
                                   Text="Key numbers and next actions stay anchored here." />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="18"
                        Style="{StaticResource SoftPanelStyle}">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   Text="Today Revenue" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="{Binding TodayRevenue, StringFormat=Rs. {0:N2}}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="18"
                        Background="{StaticResource SuccessSoftBrush}"
                        CornerRadius="{StaticResource RadiusLarge}">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Foreground="{StaticResource SuccessBrush}"
                                   Text="Active Tables" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="{Binding ActiveTables}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="18"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="{StaticResource RadiusLarge}">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Foreground="{StaticResource WarningBrush}"
                                   Text="Orders Today" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="{Binding TotalOrdersToday}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="18"
                        Style="{StaticResource SoftPanelStyle}">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   Text="Parcel Orders" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="{Binding ParcelOrdersCount}" />
                    </StackPanel>
                </Border>

                <Button Margin="0,16,0,0"
                        Command="{Binding NewTableOrderCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE8FD;" />
                        <TextBlock Text="New Table Order" />
                    </StackPanel>
                </Button>

                <Button Margin="0,12,0,0"
                        Command="{Binding GoToTablesCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE14C;" />
                        <TextBlock Text="Go to Tables" />
                    </StackPanel>
                </Button>

                <Button Margin="0,12,0,0"
                        Command="{Binding GoToMenuCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE8D2;" />
                        <TextBlock Text="Go to Menu" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
