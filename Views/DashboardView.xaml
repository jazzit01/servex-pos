<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ServeX.Views.DashboardView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperationFeedbackTemplate}"/>
            <UniformGrid Columns="4">
                <HeaderedContentControl Margin="0,0,12,12" Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource SidebarHoverBrush}" Header="Today's sales" Tag="Confirmed payments today" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding TodaySalesDisplay}" Style="{StaticResource FinancialTextStyle}" FontSize="26"/></HeaderedContentControl.Content></HeaderedContentControl>
                <HeaderedContentControl Margin="0,0,12,12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Header="Active orders" Tag="Open, preparing or served" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding ActiveOrders}" Style="{StaticResource FinancialTextStyle}" FontSize="26"/></HeaderedContentControl.Content></HeaderedContentControl>
                <HeaderedContentControl Margin="0,0,12,12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Header="Occupied tables" Tag="Currently occupied" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding OccupiedTables}" Style="{StaticResource FinancialTextStyle}" FontSize="26"/></HeaderedContentControl.Content></HeaderedContentControl>
                <HeaderedContentControl Margin="0,0,12,12" Background="{StaticResource PrimarySoftBrush}" BorderBrush="{StaticResource BorderBrush}" Header="Available tables" Tag="Ready for service" Style="{StaticResource MetricCardStyle}"><HeaderedContentControl.Content><TextBlock Text="{Binding AvailableTables}" Style="{StaticResource FinancialTextStyle}" FontSize="26"/></HeaderedContentControl.Content></HeaderedContentControl>
            </UniformGrid>
            <Border Padding="16" Margin="0,4,0,16" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <TextBlock Text="Quick actions" Style="{StaticResource SectionTitleTextStyle}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="New table order" Command="{Binding NewTableOrderCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,8,8"/>
                        <Button Content="Dining floor" Command="{Binding GoToTablesCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,8"/>
                        <Button Content="Manage menu" Command="{Binding GoToMenuCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding TotalOrdersToday, StringFormat=Orders today: {0}}" Margin="0,0,24,0" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding ParcelOrdersCount, StringFormat=Parcels today: {0}}" Margin="0,0,24,0" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding ReservedTables, StringFormat=Reserved tables: {0}}" Foreground="{StaticResource MutedTextBrush}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Unpaid orders" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding OpenOrders}" Style="{StaticResource OperationalGridStyle}" MaxHeight="240" IsReadOnly="True" Visibility="{Binding HasOpenOrders, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Unpaid orders">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding DisplayTotal}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No unpaid orders." Foreground="{StaticResource MutedTextBrush}"
                               Visibility="{Binding IsOpenOrdersEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Recent orders" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding RecentOrders}" Style="{StaticResource OperationalGridStyle}" MinHeight="100" MaxHeight="360" IsReadOnly="True" Visibility="{Binding HasRecentOrders, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Recent orders">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderId, StringFormat=#{0}}" Width="80"/>
                            <DataGridTextColumn Header="Guest / reference" Binding="{Binding ReferenceLabel}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="85"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding DisplayTotal}" Width="160" ElementStyle="{StaticResource FinancialTextStyle}"/>
                            <DataGridTextColumn Header="Created (local)" Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd MMM HH:mm}}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No orders yet." Foreground="{StaticResource MutedTextBrush}"
                               Visibility="{Binding IsRecentOrdersEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
