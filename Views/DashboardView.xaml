<UserControl x:Class="ServeX.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ServeX.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E3EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Dashboard"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0F172A" />
                <TextBlock Margin="0,8,0,0"
                           Text="A quick pulse on revenue, tables, and what just happened today."
                           Foreground="#64748B" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    Padding="14"
                    CornerRadius="16"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           Foreground="#0F172A" />
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,22,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid Columns="4"
                             Margin="0,0,0,22">
                    <Border Margin="0,0,16,0"
                            Padding="20"
                            Background="#FFF7ED"
                            CornerRadius="24">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="#EA580C"
                                       Text="&#xEAFD;" />
                            <TextBlock Margin="0,18,0,0"
                                       Foreground="#9A3412"
                                       Text="Today Revenue" />
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#7C2D12"
                                       Text="{Binding TodayRevenue, StringFormat=Rs. {0:N2}}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,16,0"
                            Padding="20"
                            Background="#ECFDF5"
                            CornerRadius="24">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="#0F766E"
                                       Text="&#xE14C;" />
                            <TextBlock Margin="0,18,0,0"
                                       Foreground="#0F766E"
                                       Text="Active Tables" />
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#115E59"
                                       Text="{Binding ActiveTables}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,16,0"
                            Padding="20"
                            Background="#EFF6FF"
                            CornerRadius="24">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="#2563EB"
                                       Text="&#xE8FD;" />
                            <TextBlock Margin="0,18,0,0"
                                       Foreground="#1D4ED8"
                                       Text="Orders Today" />
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#1E3A8A"
                                       Text="{Binding TotalOrdersToday}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="20"
                            Background="#FAF5FF"
                            CornerRadius="24">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="#9333EA"
                                       Text="&#xE7BF;" />
                            <TextBlock Margin="0,18,0,0"
                                       Foreground="#7E22CE"
                                       Text="Parcel Orders" />
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#6B21A8"
                                       Text="{Binding ParcelOrdersCount}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1"
                        Padding="24"
                        Background="White"
                        BorderBrush="#D8E3EC"
                        BorderThickness="1"
                        CornerRadius="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Recent Orders"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="The last five orders across the floor."
                                           Foreground="#64748B" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="12,8"
                                    Background="#F8FAFC"
                                    CornerRadius="999">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Text="{Binding TotalOrdersToday, StringFormat=Today: {0}}" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,22,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecentOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12"
                                                    Padding="16"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="20">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontWeight="Bold"
                                                                       Foreground="#0F172A"
                                                                       Text="{Binding OrderId, StringFormat=Order #{0}}" />
                                                            <Border Margin="12,0,0,0"
                                                                    Padding="10,4"
                                                                    Background="#E2E8F0"
                                                                    CornerRadius="999">
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Foreground="#334155"
                                                                           Text="{Binding Type}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Foreground="#64748B"
                                                                   Text="{Binding ReferenceLabel}" />
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Foreground="#94A3B8"
                                                                   Text="{Binding CreatedAt, StringFormat={}{0:dd MMM yyyy hh:mm tt}}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                HorizontalAlignment="Right">
                                                        <Border Padding="12,6"
                                                                CornerRadius="999">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderStatus.Billed}">
                                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderStatus.Cancelled}">
                                                                            <Setter Property="Background" Value="#FEE2E2" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderStatus.Billed}">
                                                                                <Setter Property="Foreground" Value="#15803D" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OrderStatus.Cancelled}">
                                                                                <Setter Property="Foreground" Value="#B91C1C" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="{Binding Status}" />
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Margin="0,12,0,0"
                                                                   HorizontalAlignment="Right"
                                                                   FontSize="16"
                                                                   FontWeight="Bold"
                                                                   Foreground="#0F172A"
                                                                   Text="{Binding Total, StringFormat=Rs. {0:N2}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Padding="24"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Visibility="{Binding IsRecentOrdersEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#64748B"
                                           Text="Recent orders will appear here once service begins." />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Column="1"
              Margin="24,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="24"
                    Background="#0F172A"
                    CornerRadius="28">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="Quick Actions" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#CBD5E1"
                               Text="Jump into the most common tasks without digging through tabs." />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="0,22,0,0">
                <Button Margin="0,0,0,14"
                        Command="{Binding NewTableOrderCommand}"
                        Style="{StaticResource QuickActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44"
                                Height="44"
                                Background="#DBEAFE"
                                CornerRadius="22">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#1D4ED8"
                                       Text="&#xE8FD;" />
                        </Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Text="New Table Order" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#64748B"
                                       Text="Start an order on the next available table." />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Margin="0,0,0,14"
                        Command="{Binding GoToTablesCommand}"
                        Style="{StaticResource QuickActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44"
                                Height="44"
                                Background="#DCFCE7"
                                CornerRadius="22">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#15803D"
                                       Text="&#xE14C;" />
                        </Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Text="Go to Tables" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#64748B"
                                       Text="Jump to the floor layout and live table states." />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Command="{Binding GoToMenuCommand}"
                        Style="{StaticResource QuickActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44"
                                Height="44"
                                Background="#FAE8FF"
                                CornerRadius="22">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#A21CAF"
                                       Text="&#xE8D2;" />
                        </Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Text="Go to Menu" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#64748B"
                                       Text="Manage availability, categories, and pricing." />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
