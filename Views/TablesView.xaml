<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:ServeX.Presentation.Components" xmlns:models="clr-namespace:ServeX.Models" x:Class="ServeX.Views.TablesView">
    <UserControl.Resources>
        <Style x:Key="FloorActionStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperationFeedbackTemplate}"/>
        <WrapPanel Grid.Row="1">
            <WrapPanel Visibility="{Binding IsSetupWorkspace, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Indoor" Command="{Binding ShowIndoorTablesCommand}" Margin="0,0,8,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FloorActionStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIndoorFilterSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Outdoor" Command="{Binding ShowOutdoorTablesCommand}" Margin="0,0,8,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FloorActionStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOutdoorFilterSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>
            <Button Content="Add table" Command="{Binding BeginAddCommand}" Margin="0,0,8,8"
                    Visibility="{Binding IsSetupWorkspace, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource FloorActionStyle}"/>
            <Button Command="{Binding TableActionsCommand}" Margin="0,0,8,8">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FloorActionStyle}">
                        <Setter Property="Content" Value="Table actions"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectingTableAction}" Value="True">
                                <Setter Property="Content" Value="Cancel selection"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsArrangingFloor}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSetupWorkspace}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Width="32" Padding="0" Margin="0,0,0,8" Command="{Binding ArrangeFloorCommand}"
                    ToolTip="Edit table layout" AutomationProperties.Name="Edit table layout">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FloorActionStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanManageTables}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsArrangingFloor}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Path Data="M2,12 L3,8.5 L10,1.5 L12.5,4 L5.5,11 Z M8.5,3 L11,5.5"
                      Stroke="{StaticResource TextBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
            </Button>
        </WrapPanel>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,16,0">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,0,12">
                    <TextBlock Text="{Binding AvailableTablesSummary}" ToolTip="{Binding AvailableTablesSummary}"
                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveTablesSummary}" ToolTip="{Binding ActiveTablesSummary}"
                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
                <ScrollViewer x:Name="FloorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Select a table to see its actions." Margin="4,0,0,10"
                                   Visibility="{Binding IsSelectingTableAction, Converter={StaticResource BoolToVisibility}}"/>
                        <ItemsControl x:Name="FloorGrid" ItemsSource="{Binding VisibleTables}" Width="{Binding FloorWidth}" Height="{Binding FloorHeight}"
                                      HorizontalAlignment="Left" AllowDrop="{Binding IsArrangingFloor}" DragOver="FloorDragOver" Drop="FloorDrop">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArrangingFloor}" Value="True">
                                            <Setter Property="Background" Value="{Binding FloorGridBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <Border Background="{TemplateBinding Background}">
                                        <ItemsPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding FloorLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding FloorTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="86" Height="66">
                                        <Button Content="{Binding TableNumber}" Padding="4" MinHeight="0" FontSize="15"
                                                ToolTip="{Binding TileDescription}" AutomationProperties.Name="{Binding TileDescription}"
                                                Tag="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.OpenFloorOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TableStatus.Occupied}">
                                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TableStatus.Reserved}">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TableStatus.Cleaning}">
                                                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsArrangingFloor, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="IsTabStop" Value="False"/>
                                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                <Condition Binding="{Binding DataContext.IsTablePanelOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderThickness" Value="3"/>
                                                            <Setter Property="AutomationProperties.ItemStatus" Value="Selected"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Manage table"
                                                              Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Border Background="Transparent" Cursor="SizeAll" PreviewMouseLeftButtonDown="TableMouseDown"
                                                PreviewMouseMove="TableMouseMove" PreviewMouseLeftButtonUp="TableMouseUp"
                                                Visibility="{Binding DataContext.IsArrangingFloor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Done" Command="{Binding ArrangeFloorCommand}" Style="{StaticResource FloorActionStyle}"
                                HorizontalAlignment="Left" Margin="4,8,0,0"
                                Visibility="{Binding IsArrangingFloor, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="No tables in this area." Foreground="{StaticResource MutedTextBrush}" Margin="4,12,0,0"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                        <WrapPanel Margin="4,12,0,0" AutomationProperties.Name="Table status legend">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <Border Width="12" Height="12" CornerRadius="3" BorderThickness="1"
                                        Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="Available" Margin="5,0,0,0" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <Border Width="12" Height="12" CornerRadius="3" BorderThickness="1"
                                        Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}"/>
                                <TextBlock Text="Occupied" Margin="5,0,0,0" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <Border Width="12" Height="12" CornerRadius="3" BorderThickness="1"
                                        Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}"/>
                                <TextBlock Text="Reserved" Margin="5,0,0,0" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <Border Width="12" Height="12" CornerRadius="3" BorderThickness="1"
                                        Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBrush}"/>
                                <TextBlock Text="Cleaning" Margin="5,0,0,0" FontSize="12"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            <ScrollViewer Grid.Column="1" Width="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsTablePanelOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Button Content="Close" Command="{Binding CloseTablePanelCommand}" Style="{StaticResource FloorActionStyle}"
                            HorizontalAlignment="Right" Margin="0,0,0,8"/>
                    <components:InlineTableOrder DataContext="{Binding SelectedOrder}">
                        <components:InlineTableOrder.Style>
                            <Style TargetType="components:InlineTableOrder">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasInlineOrder, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </components:InlineTableOrder.Style>
                    </components:InlineTableOrder>
                    <Border Padding="16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SurfaceCardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasInlineOrder}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <HeaderedContentControl Header="{Binding SelectedTableHeading}" Content="{Binding SelectedTableStatusDescription}" Style="{StaticResource PageHeaderStyle}"/>
                            <TextBlock Text="{Binding SelectedTableAreaLabel}" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding SelectedGuestLabel}" FontWeight="SemiBold" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGuestLabel}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedServiceCaption}" Margin="0,4,0,16" Foreground="{StaticResource MutedTextBrush}"/>
                            <Button Content="Open order" Command="{Binding OpenSelectedOrderCommand}" Style="{StaticResource FloorActionStyle}"/>
                            <Button Content="{Binding FloorStatusAction}" Command="{Binding ChangeFloorStatusCommand}" Style="{StaticResource FloorActionStyle}" Margin="0,8,0,0"/>
                            <WrapPanel Margin="0,8,0,0" Visibility="{Binding CanManageTables, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Edit" Command="{Binding EditSelectedCommand}" Style="{StaticResource FloorActionStyle}" Margin="0,0,8,0"/>
                                <Button Content="Delete table" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource FloorActionStyle}" Foreground="{StaticResource DangerBrush}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SoftPanelStyle}" Padding="16" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="Table number" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource FormTextBoxStyle}" AutomationProperties.Name="Table number" Text="{Binding EditorTableNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                            <TextBlock Text="{Binding NewTableNameHint}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Area" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableAreas}" SelectedItem="{Binding EditorArea}" Style="{StaticResource FormComboBoxStyle}" AutomationProperties.Name="Table area"/>
                            <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding EditorStatus}" Style="{StaticResource FormComboBoxStyle}" AutomationProperties.Name="Table status"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="Save table" Command="{Binding SaveCommand}" Style="{StaticResource FloorActionStyle}" Margin="0,0,8,8"/>
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource FloorActionStyle}" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
