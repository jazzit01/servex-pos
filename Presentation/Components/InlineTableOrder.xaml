<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ServeX.Presentation.Components.InlineTableOrder">
    <UserControl.Resources>
        <Style x:Key="InlineOrderActionStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource SurfaceCardStyle}" Padding="12">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding TableStatus}" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding TableNumber, StringFormat=Table {0}}" Style="{StaticResource SectionTitleTextStyle}"/>
            </DockPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperationFeedbackTemplate}"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBoxStyle}"
                     AutomationProperties.Name="Search menu items" ToolTip="Search by menu item or category" Margin="0,4,0,6"/>
            <ScrollViewer MaxHeight="126" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredMenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Margin="0,0,4,4">
                                <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource InlineOrderActionStyle}" MinWidth="42"
                                        IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Name, StringFormat=Add {0}}"
                                        Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Price, StringFormat=C2}" Margin="6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="No matching menu items." Foreground="{StaticResource MutedTextBrush}"
                       Visibility="{Binding IsMenuEmpty, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="Current order" FontWeight="SemiBold" Margin="0,12,0,6"/>
            <TextBlock Text="No items yet." Foreground="{StaticResource MutedTextBrush}"
                       Visibility="{Binding IsEmptyOrder, Converter={StaticResource BoolToVisibility}}"/>
            <ScrollViewer MaxHeight="142" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding OrderItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                <Button Grid.Column="1" Content="−" Style="{StaticResource InlineOrderActionStyle}"
                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Decrease quantity of {0}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Quantity}" Margin="6,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="+" Style="{StaticResource InlineOrderActionStyle}"
                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Increase quantity of {0}}"/>
                                <Button Grid.Column="4" Content="Remove" Style="{StaticResource InlineOrderActionStyle}" Margin="4,0,0,0"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <DockPanel Margin="0,10,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=C2}" Style="{StaticResource FinancialTextStyle}"/>
                <TextBlock Text="Total" FontWeight="SemiBold"/>
            </DockPanel>
            <WrapPanel>
                <Button Content="Save order" Command="{Binding SaveOrderCommand}" Margin="0,0,5,5"
                        Style="{StaticResource InlineOrderActionStyle}" Background="{StaticResource PrimaryBrush}"/>
                <Button Content="Cancel order" Command="{Binding CancelOrderCommand}" Margin="0,0,5,5"
                        Style="{StaticResource InlineOrderActionStyle}" Foreground="{StaticResource DangerBrush}"/>
                <Button Content="Checkout" Command="{Binding GenerateBillCommand}" Margin="0,0,0,5" Style="{StaticResource InlineOrderActionStyle}"/>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Send to kitchen" Command="{Binding SendKitchenCommand}" Margin="0,0,5,0" Style="{StaticResource InlineOrderActionStyle}"/>
                <Button Content="Mark served" Command="{Binding MarkServedCommand}" Style="{StaticResource InlineOrderActionStyle}"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
