<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <Style x:Key="SidebarNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="10,8" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="NavLabel" Grid.Column="1" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="NavLabel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Root" Property="Padding" Value="8"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SidebarTextBrush}"/>
                            <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="StatusMessageTemplate">
        <Border Margin="0,0,0,12" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource StatusBannerBorderStyle}">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="OperationFeedbackTemplate">
        <StackPanel>
            <ProgressBar Margin="0,0,0,8" Style="{StaticResource BusyIndicatorStyle}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="Working…" Margin="0,0,0,8" Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusMessageTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Status badges: bind DataContext to anything exposing StatusLabel and StatusTone (Success, Info, Warning, Accent, Danger, Neutral). The label is always shown, so colour is never the only signal. -->
    <Style x:Key="StatusBadgeBorderStyle" TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusTone}" Value="Success">
                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Info">
                <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Warning">
                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Accent">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Danger">
                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusTone}" Value="Success">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Info">
                <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Warning">
                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Accent">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Danger">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TilePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="TileSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="MinWidth" Value="160"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="GlyphTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
</ResourceDictionary>
